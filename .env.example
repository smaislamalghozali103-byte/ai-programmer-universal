# GROQ_API_KEY: Required for Groq AI inference (llama-3.3-70b-versatile, etc.)
# In Vercel, set this in Settings > Environment Variables.
# In local development / container, provide your Groq API key here.
GROQ_API_KEY=""

# GEMINI_API_KEY: Optional fallback for AI responses if Groq key is not configured.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_SHEET_WEBAPP_URL: Optional Google Apps Script Web App URL for auto-logging chats.
GOOGLE_SHEET_WEBAPP_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
